<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_chip"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/itemAppPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 已授权标记：只有被勾选的应用才显示 -->
    <TextView
        android:id="@+id/itemAppAllowed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_tag_allowed"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/success"
        android:background="@drawable/bg_tag_allowed"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="6dp"
        android:visibility="gone" />

    <!-- 系统 / 用户应用徽章，配色区分 -->
    <TextView
        android:id="@+id/itemAppTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_tag_user"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginEnd="6dp" />

    <Switch
        android:id="@+id/itemAppSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:focusable="false"
        android:clickable="false" />
</LinearLayout>
