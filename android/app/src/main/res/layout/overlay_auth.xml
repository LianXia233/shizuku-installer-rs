<?xml version="1.0" encoding="utf-8"?>
<!--
  跨应用授权卡片：以 TYPE_APPLICATION_OVERLAY 叠加在当前前台应用之上。

  之所以不是 Activity/Dialog：那两者都会创建可聚焦窗口 —— Dialog 还会铺一层
  全屏半透明背板（就是用户反复看到的「一层遮罩、点不动」），Activity 则会把本应用
  task 拉到前台。系统悬浮窗是唯一「浮在别人之上、不切换任务、不 pause 前台应用」
  的窗口类型，配合 WRAP_CONTENT + NOT_FOCUSABLE + NOT_TOUCH_MODAL，
  卡片之外的触摸与返回键全部穿透给前台应用。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ovRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/ovTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_dialog_title"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ovMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ovCaller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <CheckBox
        android:id="@+id/ovRemember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:text="@string/auth_remember"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOvDeny"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/auth_deny"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnOvAllow"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/auth_allow"
            android:textAllCaps="false"
            android:textColor="@color/on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/auth_overlay_hint"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />
</LinearLayout>
