<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/window_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_subtitle"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp" />

    <!-- 授权与安装行为 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_card_title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_card_desc"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/tvAuthWarn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_disabled_warn"
            android:textSize="12sp"
            android:textColor="@color/danger"
            android:visibility="gone"
            android:layout_marginTop="6dp" />

        <Switch
            android:id="@+id/swCallerAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/opt_caller_auth"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:checked="true"
            android:layout_marginTop="8dp" />

        <Switch
            android:id="@+id/swFloating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/opt_floating"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:checked="true" />

        <Switch
            android:id="@+id/swFallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/opt_fallback"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:checked="true" />

        <Switch
            android:id="@+id/swAutoOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/opt_auto_open"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:checked="false" />

        <Switch
            android:id="@+id/swConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/opt_confirm"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:checked="false" />
    </LinearLayout>

    <!-- 系统应用列表，开关授权 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_app_list_title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_app_list_hint"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvAllowedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/brand_primary"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="@string/auth_search_hint"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:importantForAutofill="no" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnRevokeAll"
                android:layout_width="88dp"
                android:layout_height="44dp"
                android:text="@string/auth_revoke_all"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <ListView
                android:id="@+id/appList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none"
                android:fastScrollEnabled="true"
                android:choiceMode="none" />

            <TextView
                android:id="@+id/appEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/auth_loading"
                android:textSize="13sp"
                android:textColor="@color/text_muted" />
        </FrameLayout>
    </LinearLayout>

    <!-- 高级：原有免确认白名单，默认折叠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/advancedToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/advanced_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/advancedArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/advanced_expand"
                android:textSize="12sp"
                android:textColor="@color/brand_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advancedBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPackage"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="@string/allow_hint"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:text="@string/allow_add"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:background="@drawable/btn_primary"
                    android:textColor="@color/on_brand" />
            </LinearLayout>

            <Button
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/allow_clear"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_primary"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
