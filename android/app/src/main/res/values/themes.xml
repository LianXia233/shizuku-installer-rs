<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:colorControlNormal">@color/brand_primary</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <!--
      外部安装意图的入口：Theme.NoDisplay 让系统完全不为它创建窗口 / surface，
      因此即便 onCreate 里同步复制安装包耗时，屏幕上也不会出现任何全屏窗口，
      更不会把状态栏、导航栏染黑或吞掉前台触摸。

      不要再改成「普通窗口 + 代码把尺寸压到 1x1」：Activity 主窗口
      (TYPE_BASE_APPLICATION) 在不少 ROM 上会被强制回 MATCH_PARENT，
      配合 @null / 透明背景就会合成出整屏纯黑 —— 这正是上一版的黑屏来源。
    -->
    <style name="Theme.SilentEntry" parent="android:style/Theme.NoDisplay">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- 首次调用的授权卡片：整条链路唯一需要用户交互的界面，居中对话框 + dim 是合理的 -->
    <style name="Theme.AuthDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

</resources>
